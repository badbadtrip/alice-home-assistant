{
  "listen": "127.0.0.1:18861",
  "upstream": "wss://uniproxy.alice.yandex.net/uni.ws",
  "mode": "hybrid",
  "tls_cert": "",
  "tls_key": "",
  "allowed_ips": [
    "127.0.0.1",
    "::1"
  ],
  "llm_base_url": "https://omniroute.example.invalid/v1",
  "llm_model": "alice-gemini",
  "llm_api": "chat_completions",
  "llm_chat_parameters": {
    "max_tokens": 1024,
    "chat_template_kwargs": null
  },
  "llm_hosted_tools": [],
  "listen_after_reply": true,
  "routing": {
    "rules": [
      {
        "name": "alarms_timers_reminders",
        "route": "yandex",
        "match": {
          "regex": "^\\s*(?:алиса[,\\s]+)?(?:пожалуйста[,\\s]+)?(?:(?:поставь|установи|заведи|включи|создай|запусти|отмени|удали|выключи|останови|перенеси|измени|покажи|назови|перечисли|проверь)\\s+(?:(?:мне|мой|мои|все|новый|ещё|еще|на|сегодня|завтра)\\s+){0,3}(?:будильник\\S*|таймер\\S*|напоминани\\S*)(?:\\s|[,.!?]|$)|(?:поставь|создай|добавь|установи)\\s+(?:мне\\s+)?напоминани\\S*(?:\\s|[,.!?]|$)|напомни\\s|разбуди\\s|(?:какие|сколько|когда)\\s+(?:(?:у\\s+меня|мои|стоит|заведено|поставлено|включены|установлены|следующий)\\s+){0,3}(?:будильник\\S*|таймер\\S*|напоминани\\S*)(?:\\s|[,.!?]|$)|(?:выключи|отмени|удали)\\s+(?:все\\s+)?(?:будильники|таймеры|напоминания))"
        }
      },
      {
        "name": "weather_forecast",
        "route": "yandex",
        "match": {
          "regex": "^\\s*(?:алиса[,\\s]+)?(?:пожалуйста[,\\s]+)?(?:(?:погода|прогноз\\s+погоды)(?:\\s|[,.!?]|$)|(?:какая|какую)\\s+(?:(?:сейчас|сегодня|завтра|будет|у\\s+нас)\\s+){0,3}погод\\S*|(?:расскажи|скажи|покажи|подскажи|узнай)\\s+(?:мне\\s+)?(?:про\\s+|о\\s+)?(?:погод\\S*|прогноз\\s+погоды)|что\\s+(?:сейчас\\s+)?с\\s+погодой|(?:будет\\s+ли|ожидается\\s+ли)\\s+(?:(?:сегодня|завтра|вечером|ночью|утром)\\s+){0,2}(?:дождь|снег|гроза|мороз)|(?:нужен\\s+ли|брать\\s+ли|нужно\\s+ли\\s+брать)\\s+(?:сегодня\\s+|завтра\\s+)?зонт|(?:какая\\s+(?:сейчас\\s+)?температура|сколько\\s+(?:сейчас\\s+)?градусов)\\s+(?:воздуха\\s+)?(?:на\\s+улице|за\\s+окном|снаружи))"
        }
      },
      {
        "name": "ask_model",
        "route": "llm",
        "match": {
          "regex": "^\\s*(?:алиса[,\\s]+)?(?:пожалуйста[,\\s]+)?(?:(?:спроси|узнай|уточни)\\s+(?:у\\s+)?(?:нейросет\\S*|нейронк\\S*|сво(?:ю|ей)\\s+модел\\S*|модел\\S*)|(?:задай\\s+(?:вопрос\\s+)?|скажи\\s+|ответь\\s+)?нейросет\\S*|(?:ответь|скажи)\\s+(?:через|с\\s+помощью)\\s+нейросет\\S*|(?:найди|поищи|посмотри|глянь|загугли|проверь|узнай)\\s+(?:в\\s+)?(?:интернете|сети|гугле|google)|загугли\\s)"
        }
      },
      {
        "name": "home_functions",
        "route": "home",
        "match": {
          "contains_all_groups": [
            [
              "свет",
              "ламп",
              "люстр",
              "выключател",
              "освещен",
              "освещён",
              "устройств",
              "кормуш"
            ]
          ],
          "contains_none": [
            "музыку",
            "песню",
            "радио",
            "трек",
            "будильник",
            "таймер"
          ],
          "regex": "^\\s*(?:алиса[,\\s]+)?(?:пожалуйста[,\\s]+)?(?:включи|выключи|отключи|погаси|зажги|сделай|прибавь|убавь|установи|поставь|измени|переключи)(?:\\s|[,!?]|$)"
        }
      },
      {
        "name": "home_word_order",
        "route": "home",
        "match": {
          "regex": "^\\s*(?:алиса[,\\s]+)?(?:пожалуйста[,\\s]+)?(?:свет|освещение)\\s+(?:.*\\s)?(?:включи|выключи|отключи|погаси|зажги)\\s*[.!]?\\s*$"
        }
      },
      {
        "name": "home_state",
        "route": "home",
        "match": {
          "regex": "^\\s*(?:алиса[,\\s]+)?(?:пожалуйста[,\\s]+)?(?:(?:горит|включен|включён|включена|включено|выключен|выключена)\\s+ли\\s|что\\s+(?:сейчас\\s+)?включено)"
        }
      },
      {
        "name": "direct_play",
        "route": "yandex",
        "match": {
          "regex": "^\\s*(?:алиса[,\\s]+)?(?:пожалуйста[,\\s]+)?(?:включи|проиграй|воспроизведи|сыграй)\\s+",
          "contains_none": [
            "воображение",
            "фантазию",
            "логику",
            "мозги"
          ]
        }
      },
      {
        "name": "playback_and_volume",
        "route": "yandex",
        "match": {
          "regex": "^\\s*(?:алиса[,\\s]+)?(?:пожалуйста[,\\s]+)?(?:(?:сделай\\s+)?(?:потише|погромче)\\s*[.!?]*$|(?:стоп|хватит|пауза|тише|громче|дальше|следующ(?:ая|ий|ую)|предыдущ(?:ая|ий|ую))(?:\\s+(?:трек|песн\\S*))?\\s*[.!?]*$|(?:включи|поставь|запусти|переключи|выключи|останови|продолжи|возобнови|перемотай|найди|сыграй)\\s+(?:.*\\s)?(?:музык\\S*|песн\\S*|трек\\S*|радио|плейлист\\S*|альбом\\S*|подкаст\\S*)(?:\\s|[,.!?]|$)|(?:переключи|переключай)\\s+(?:на\\s+)?|поставь\\s+на\\s+паузу|(?:прибавь|убавь|сделай|установи|измени)\\s+(?:звук|громкость)|(?:громкость|звук)\\s+(?:на\\s+)?(?:\\d|ноль|один|два|три|четыре|пять|шесть|семь|восемь|девять|десять|максимум|минимум)|(?:что\\s+(?:это\\s+)?(?:за\\s+песня|играет)|(?:как\\s+называется\\s+эта\\s+песня)))"
        }
      },
      {
        "name": "devices_and_modes",
        "route": "yandex",
        "match": {
          "regex": "^\\s*(?:алиса[,\\s]+)?(?:пожалуйста[,\\s]+)?(?:(?:включи|выключи|открой|закрой|погаси|зажги|прибавь|убавь|установи|поставь|сделай)\\s+(?:.*\\s)?(?:свет\\S*|ламп\\S*|люстр\\S*|розетк\\S*|штор\\S*|кондиционер\\S*|обогрев\\S*|термостат\\S*|вентилятор\\S*|пылесос\\S*|телевизор\\S*|режим\\s+не\\s+беспокоить|ночной\\s+режим|bluetooth|блютуз)(?:\\s|[,.!?]|$)|(?:соедини|подключи)\\s+(?:.*\\s)?(?:bluetooth|блютуз)(?:\\s|[,.!?]|$))"
        }
      },
      {
        "name": "clock_date",
        "route": "yandex",
        "match": {
          "regex": "^\\s*(?:алиса[,\\s]+)?(?:который час|сколько (?:сейчас )?времени|какое сегодня число|какой сегодня день(?: недели)?|какая сегодня дата)\\s*[.!?]*$"
        }
      }
    ],
    "default_route": "yandex",
    "refusal": {
      "enabled": true
    }
  },
  "assistant_tools": {
    "enabled": false,
    "web": false,
    "history": false,
    "time": false,
    "play_sound": false,
    "mcp_servers": []
  },
  "conversation_log": {
    "enabled": false
  },
  "local_progress": {
    "enabled": true,
    "after_ms": 2000,
    "interval_ms": 4000
  },
  "dialogue_context": {
    "enabled": true,
    "ttl_seconds": 300,
    "max_turns": 6,
    "max_chars": 12000
  },
  "system_prompt": "Отвечай по-русски, кратко и понятно. Если данных нет, скажи об этом. Не повторяй «Думаю»: колонка произносит это сама. Не изображай поиск в интернете или выполнение действий, если соответствующий инструмент не подключён.",
  "voice_cues": {
    "enabled": true,
    "cache_dir": "/data/opt/quasar-bridge/cues"
  }
}
